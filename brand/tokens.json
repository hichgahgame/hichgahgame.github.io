{
  "$comment": "Hichgah brand tokens: the single source of truth. Edit here, then run `python3 brand/build.py` to regenerate brand/tokens.css (website) and brand/unity/ (games). Never edit the generated files by hand.",
  "palette": {
    "violet":    { "base": "#7B3FFF", "deep": "#5A1FE0", "soft": "#EEE6FF", "night": "#B69BFF" },
    "pink":      { "base": "#FF4FA3", "deep": "#C8186E", "soft": "#FFE3F1", "night": "#FF8FC4" },
    "coral":     { "base": "#FF6B4A", "deep": "#C63C1A", "soft": "#FFE6DE", "night": "#FF9C85" },
    "tangerine": { "base": "#FF9F1C", "deep": "#A85A00", "soft": "#FFEFD6", "night": "#FFC066" },
    "sun":       { "base": "#FFD23F", "deep": "#8A6800", "soft": "#FFF6D1", "night": "#FFE07A" },
    "leaf":      { "base": "#2ECC71", "deep": "#0F7A41", "soft": "#DDF7E8", "night": "#6FE3A0" },
    "sky":       { "base": "#1FB5FF", "deep": "#0068AD", "soft": "#DDF3FF", "night": "#7FD3FF" }
  },
  "neutral": {
    "ink":       "#1D1440",
    "ink-soft":  "#3F3566",
    "muted":     "#5F5587",
    "line":      "#E6DFF7",
    "paper":     "#FCFAFF",
    "white":     "#FFFFFF",
    "night":     "#120B29",
    "night-surface": "#1E1640",
    "night-line":    "#33286A",
    "night-text":    "#F6F2FF",
    "night-muted":   "#BDB3DF"
  },
  "gradient": {
    "$comment": "The Now: violet into pink into tangerine. Hero and closing panels, the logo ring, splash screens.",
    "now":  ["#7B3FFF", "#FF4FA3", "#FF9F1C"],
    "dusk": ["#4A1BC9", "#9A22C8", "#C8186E"]
  },
  "theme": {
    "light": {
      "bg": "paper", "surface": "white", "text": "ink", "text-soft": "ink-soft", "muted": "muted", "line": "line",
      "accent": "violet.deep", "accent-soft": "violet.soft", "good": "leaf.deep", "warn": "tangerine.deep", "bad": "coral.deep"
    },
    "dark": {
      "bg": "night", "surface": "night-surface", "text": "night-text", "text-soft": "night-text", "muted": "night-muted", "line": "night-line",
      "accent": "violet.night", "accent-soft": "#2F2366", "good": "leaf.night", "warn": "tangerine.night", "bad": "coral.night"
    }
  },
  "game": {
    "$comment": "Meaning every game shares, so a star or a reward looks the same everywhere.",
    "star": "sun.base", "reward": "tangerine.base", "success": "leaf.base", "mistake": "coral.base",
    "hint": "sky.base", "primary-button": "violet.base", "primary-button-edge": "violet.deep", "secondary-button": "pink.base"
  },
  "font": {
    "display": "Lilita One",
    "serif": "Fraunces",
    "body": "system-ui"
  },
  "radius": { "sm": 8, "md": 16, "lg": 24, "xl": 32, "pill": 999 },
  "space":  { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40, "xxl": 64 },
  "motion": {
    "$comment": "Seconds. Calm is the brand: prefer base and calm; fast only for taps.",
    "fast": 0.15, "base": 0.3, "calm": 0.6, "breath": 9
  }
}
